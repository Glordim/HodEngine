#include <HodEngine/Game/RuntimeModule.hpp>

extern "C"
{
@HOD_MODULE_DECLARATIONS@}

// Called by Application::InitGame: the runtime modules of the game, dependencies first
extern "C" const hod::game::RuntimeModule* const* HodGetRuntimeModules(uint32_t* count)
{
	static const hod::game::RuntimeModule* const modules[] = {
@HOD_MODULE_ENTRIES@		nullptr,
	};
	*count = @HOD_MODULE_COUNT@;
	return modules;
}
